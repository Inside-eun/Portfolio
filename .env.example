# Admin page (/admin) password
ADMIN_PASSWORD=change-me

# Set automatically by Vercel when a Blob store is connected to the project
# (BLOB_STORE_ID for OIDC connections, BLOB_READ_WRITE_TOKEN for token ones).
# Without either, uploads are stored in the local ./data folder.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
